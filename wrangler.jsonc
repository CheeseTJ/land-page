{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "land-page",
  "account_id": "1b53bebb48213cfdf6e43cd71d931741",
  "compatibility_date": "2026-06-01",
  // Worker 名必须与 `name` 一致，否则 CF 侧构建会失败
  "assets": {
    "directory": "dist",
    // 无客户端路由，静态文件直接命中，不需要回退
    "not_found_handling": "none"
  },
  // 关掉 workers.dev，只走自定义域（绑定时 wrangler 自动建 AAAA 100:: 占位）
  "workers_dev": false,
  "preview_urls": false,
  // 只绑根域。
  // ⚠️ 不要绑 www.taojun.top：该域名由 Zone 的 Redirect Rule
  // （http_request_dynamic_redirect，规则 "www.taojun.top -> taojun.top (canonical 301)"）
  // 处理成 301。若绑到 Worker，Worker 自定义域会先于 Redirect Rule 生效，
  // 导致 www 不再跳转（实测 2026-11-09）。保持不绑即维持原 301 行为。
  "routes": [
    { "pattern": "taojun.top", "custom_domain": true }
  ]
}
